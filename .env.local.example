# Perch dev config. Copy this file to `.env.local` (same folder, next to perch.slnx) and fill in your
# Supabase project's values. `.env.local` is gitignored, so the publishable key never lands in the repo.
# Dev builds read it automatically (see Perch.Social.SupabaseConfig). Real environment variables of the
# same name still win over this file.
#
# Use the publishable key only (a legacy `anon` key works in the same slot) - NEVER the service_role / secret key.

PERCH_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PERCH_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...your-publishable-key...

# Set to 1 to show the Social developer testing tool (Settings -> Social -> "Testing tool"),
# which drives a second "puppet" account so you can test the friends/posts/reactions loop from
# one machine. Off unless set. See backend/supabase/README.md ("Testing from one machine").
# PERCH_SOCIAL_DEBUG=1
