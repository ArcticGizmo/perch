<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Perch.Avalonia.App"
             RequestedThemeVariant="Dark">
    <!-- Dark is only the startup default (Perch ships dark); ThemeService.Apply overrides the variant per
         theme at launch and on every theme swap, so a light theme flips the Fluent chrome to light. -->
    <Application.Styles>
        <FluentTheme />
        <!-- Material-style colour picker (Avalonia.Controls.ColorPicker) used by the theme designer. -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    </Application.Styles>
</Application>
